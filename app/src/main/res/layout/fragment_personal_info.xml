<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/mainBackground"
    tools:context=".onboarding.personal.PersonalInfoFragment">

    <!-- Botón anclado al fondo -->
    <com.google.android.material.button.MaterialButton style="@style/signUpButton"
        android:id="@+id/saveButton"
        android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_marginStart="32dp" android:layout_marginEnd="32dp" android:layout_marginBottom="24dp"
        android:text="@string/save"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent" android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/saveButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:paddingBottom="24dp">

            <TextView android:id="@+id/tvTitle"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="32dp" android:text="@string/personalInfoTitle"
                android:textColor="@color/primary" android:textSize="22sp" android:textStyle="bold"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progressIndicator"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_marginStart="32dp" android:layout_marginTop="20dp" android:layout_marginEnd="32dp"
                android:progress="100" android:max="100"
                app:indicatorColor="@color/primary"
                app:trackColor="@color/strokeColor"
                app:trackCornerRadius="8dp"
                app:layout_constraintTop_toBottomOf="@+id/tvTitle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <TextView android:id="@+id/tvStep"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="32dp" android:layout_marginTop="16dp"
                android:text="@string/personalInfoStep"
                android:textColor="@color/textSecondary" android:textSize="13sp"
                app:layout_constraintTop_toBottomOf="@+id/progressIndicator"
                app:layout_constraintStart_toStartOf="parent"/>

            <TextView android:id="@+id/tvIntro"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="32dp" android:layout_marginTop="4dp"
                android:text="@string/personalInfoIntro"
                android:textColor="@color/textPrimary" android:textSize="15sp"
                android:textStyle="italic"
                app:layout_constraintTop_toBottomOf="@+id/tvStep"
                app:layout_constraintStart_toStartOf="parent"/>

            <com.google.android.material.textfield.TextInputLayout style="@style/passwordTil"
                android:id="@+id/firstNameTil"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_marginStart="32dp" android:layout_marginTop="20dp" android:layout_marginEnd="32dp"
                android:hint="@string/firstName"
                app:layout_constraintTop_toBottomOf="@+id/tvIntro"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">
                <com.google.android.material.textfield.TextInputEditText style="@style/passwordTiet"
                    android:id="@+id/firstNameTiet" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:inputType="textPersonName"/>
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout style="@style/passwordTil"
                android:id="@+id/lastNameTil"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_marginStart="32dp" android:layout_marginTop="16dp" android:layout_marginEnd="32dp"
                android:hint="@string/lastName"
                app:layout_constraintTop_toBottomOf="@+id/firstNameTil"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">
                <com.google.android.material.textfield.TextInputEditText style="@style/passwordTiet"
                    android:id="@+id/lastNameTiet" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:inputType="textPersonName"/>
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout style="@style/passwordTil"
                android:id="@+id/usernameTil"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_marginStart="32dp" android:layout_marginTop="16dp" android:layout_marginEnd="32dp"
                android:hint="@string/username"
                app:layout_constraintTop_toBottomOf="@+id/lastNameTil"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">
                <com.google.android.material.textfield.TextInputEditText style="@style/passwordTiet"
                    android:id="@+id/usernameTiet" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:inputType="text"/>
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout style="@style/passwordTil"
                android:id="@+id/phoneTil"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_marginStart="32dp" android:layout_marginTop="16dp" android:layout_marginEnd="32dp"
                android:hint="@string/phone"
                app:layout_constraintTop_toBottomOf="@+id/usernameTil"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">
                <com.google.android.material.textfield.TextInputEditText style="@style/passwordTiet"
                    android:id="@+id/phoneTiet" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:inputType="phone"
                    android:maxLength="14"/>
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout style="@style/passwordTil"
                android:id="@+id/birthDateTil"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_marginStart="32dp" android:layout_marginTop="16dp"
                android:layout_marginEnd="32dp" android:layout_marginBottom="24dp"
                android:hint="@string/birthDate"
                app:endIconMode="custom" app:endIconTint="@color/primary"
                app:endIconDrawable="@android:drawable/ic_menu_my_calendar"
                app:layout_constraintTop_toBottomOf="@+id/phoneTil"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">
                <com.google.android.material.textfield.TextInputEditText style="@style/passwordTiet"
                    android:id="@+id/birthDateTiet" android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:focusable="false" android:clickable="true"
                    android:inputType="none"/>
            </com.google.android.material.textfield.TextInputLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
